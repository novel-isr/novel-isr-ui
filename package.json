{
  "name": "@novel-isr/ui",
  "version": "0.1.21",
  "description": "novel-platform UI 组件库 —— Chakra v3 inspired API + 现代克制视觉 + 一等公民 dark mode",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/novel-isr/novel-isr-ui.git"
  },
  "homepage": "https://github.com/novel-isr/novel-isr-ui",
  "bugs": "https://github.com/novel-isr/novel-isr-ui/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme-utils": {
      "types": "./dist/components/theme-utils.d.ts",
      "import": "./dist/theme-utils.js"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^1.14.0",
    "dompurify": "^3.4.15"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": { "optional": true },
    "monaco-editor": { "optional": true }
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:dts && pnpm run build:css",
    "build:js": "vite build",
    "build:dts": "tsc --emitDeclarationOnly",
    "build:css": "sass src/styles/index.scss dist/styles.css --no-source-map --style=compressed",
    "dev": "concurrently 'pnpm run build:js -- --watch' 'pnpm run build:css --watch'",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "0.52.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.99.0",
    "typescript": "^5.6.2",
    "vite": "^8.0.10",
    "vitest": "^2.1.5"
  }
}
